# Claude API key for generated answers. Leave unset to run on extractive answers only (no model cost).
ANTHROPIC_API_KEY=
# Model for answers (short, grounded; a small model is plenty)
MODEL=claude-haiku-5-5
# Token for /admin (referral stats, hiding guest-book pages). Leave unset to disable admin.
ADMIN_TOKEN=
PORT=8787
BROADCASTER=packy
DB_FILE=data/notebook.db
# Set to 1 when running behind a reverse proxy, so rate limits see the visitor's address
TRUST_PROXY=0
